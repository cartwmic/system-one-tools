{
  "name": "@cartwmic/pi-system-one",
  "version": "0.1.0",
  "description": "Pi System One agent tool and owner-facing /so controls.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./internal": {
      "types": "./src/internal.d.ts",
      "import": "./src/internal.js"
    }
  },
  "pi": {
    "extensions": ["./src/index.js"]
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "node --check src/index.js && node --check src/internal.js && node --check src/ui.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@cartwmic/system-one-connections": "^0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "typebox": { "optional": true }
  }
}
